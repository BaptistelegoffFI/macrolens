 "schemas": {
  "AnalogOut": {
   "properties": {
    "context_events": {
     "items": {
      "$ref": "#/components/schemas/ContextEventOut"
     },
     "title": "Context Events",
     "type": "array"
    },
    "country": {
     "title": "Country",
     "type": "string"
    },
    "distance": {
     "title": "Distance",
     "type": "number"
    },
    "feature_contributions": {
     "additionalProperties": {
      "type": "number"
     },
     "title": "Feature Contributions",
     "type": "object"
    },
    "outcomes": {
     "additionalProperties": {
      "additionalProperties": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "boolean"
        },
        {
         "type": "integer"
        },
        {
         "type": "null"
        }
       ]
      },
      "type": "object"
     },
     "title": "Outcomes",
     "type": "object"
    },
    "similarity": {
     "title": "Similarity",
     "type": "number"
    },
    "state": {
     "items": {
      "$ref": "#/components/schemas/StateFeatureOut"
     },
     "title": "State",
     "type": "array"
    },
    "year": {
     "title": "Year",
     "type": "integer"
    }
   },
   "required": [
    "country",
    "year",
    "distance",
    "similarity",
    "feature_contributions",
    "state",
    "context_events",
    "outcomes"
   ],
   "title": "AnalogOut",
   "type": "object"
  },
  "AnalogsSearchRequest": {
   "properties": {
    "anchor": {
     "anyOf": [
      {
       "$ref": "#/components/schemas/AnchorSpec"
      },
      {
       "type": "null"
      }
     ]
    },
    "filters": {
     "$ref": "#/components/schemas/FiltersSpec"
    },
    "horizons": {
     "items": {
      "type": "integer"
     },
     "title": "Horizons",
     "type": "array"
    },
    "k": {
     "default": 20,
     "maximum": 100.0,
     "minimum": 1.0,
     "title": "K",
     "type": "integer"
    },
    "metric": {
     "const": "euclidean",
     "default": "euclidean",
     "title": "Metric",
     "type": "string"
    },
    "mode": {
     "default": "anchor",
     "enum": [
      "anchor",
      "manual",
